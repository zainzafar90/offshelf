{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@types/chrome", "@types/node", "vitest/globals", "wxt/vite-builder-env"]
  },
  "include": ["src/**/*", "entrypoints/**/*", "tests/**/*", "e2e/**/*", "vitest.config.ts", "wxt.config.ts", "playwright.config.ts", ".wxt/wxt.d.ts"],
  "exclude": ["node_modules", ".output"]
}
