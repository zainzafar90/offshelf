{
  "name": "offshelf",
  "version": "1.0.0",
  "description": "Save articles and X threads with images. Read offline. Export HTML, Markdown and print-ready PDF.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "wxt build",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "site:deploy": "wrangler deploy",
    "site:preview": "wrangler dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.141.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
